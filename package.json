{
  "name": "ii",
  "version": "2.0.0",
  "description": "Serious Fucking Index",
  "author": "tong@disktree.net",
  "license": "ISC",
  "private": true,
  "homepage": "https://ii.disktree.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/disktree/ii.git"
  },
  "devDependencies": {
    "dotenv": "^16.3.1",
    "hugo-bin": "^0.141.2",
    "sass": "^1.85.0"
  },
  "hugo-bin": {
    "buildTags": "extended"
  },
  "scripts": {
    "start": "npm run build:style && hugo server",
    "clean": "rm -rf public && rm -f static/style.css*",
    "dev:style": "sass --load-path=style/lib/enron style/main.scss static/style.css -w",
    "build:style": "sass --load-path=style/lib/enron style/main.scss static/style.css --style compressed --no-source-map",
    "build:hugo": "hugo -e production",
    "build": "npm run build:style && npm run build:hugo",
    "update:code": "node scripts/update-code.mjs",
    "deploy": "scripts/deploy.sh"
  }
}
